{
  "name": "admin",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "yarn dev -- --open",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format:check": "prettier . --check .",
    "format": "prettier --write --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss .",
    "test": "TZ=America/New_York jest",
    "test:rules": "TZ=America/New_York jest --config jest.rules.config.ts",
    "email:build": "npx tsx --import ./scripts/emails/alias-hook.mjs scripts/emails/build.ts",
    "email:check": "npx tsx --import ./scripts/emails/alias-hook.mjs scripts/emails/build.ts --check",
    "email:goldens": "npx tsx --import ./scripts/emails/alias-hook.mjs scripts/emails/goldens.ts",
    "email:preview": "npx tsx --import ./scripts/emails/alias-hook.mjs scripts/emails/preview.ts",
    "cypress": "cypress run",
    "deploy": "yarn build && firebase deploy",
    "seed": "npx tsx scripts/seed.ts",
    "backfill:instructoruids": "npx tsx scripts/backfill-class-instructor-uids.ts",
    "backfill:instructoruids:dry": "npx tsx scripts/backfill-class-instructor-uids.ts --dry-run",
    "backfill:instructoruids:drop": "npx tsx scripts/backfill-class-instructor-uids.ts --drop-legacy-field",
    "verify-email": "npx tsx scripts/force-verify-email.ts",
    "verify-email:dry": "npx tsx scripts/force-verify-email.ts --dry-run",
    "emulators": "firebase emulators:start --log-verbosity=quiet",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mjml": "^5",
    "@types/node": "^24.0.0",
    "@types/nprogress": "^0.2.3",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "cypress": "^16.0.0",
    "cypress-terminal-report": "^7.3.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^30.0.1",
    "mjml": "^5.4.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "type": "module",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "algoliasearch": "^5.57.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "formsnap": "^2.0.1",
    "handlebars": "^4.7.9",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "dependenciesMeta": {
    "@firebase/util": {
      "built": true
    },
    "cypress": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "protobufjs": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  },
  "packageManager": "yarn@4.17.1"
}
