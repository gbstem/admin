rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    //
    // NOTE: THIS MUST BE MERGED WITH THE CURRICULUM REPO firestore.rules BEFORE DEPLOYMENT
    //

    //
    // admin.gbstem.org and portal.gbstem.org data
    //

    // A person's name, and nothing else. Their role is the Auth custom claim
    // (hasRRole below) and has no copy here: this document used to carry one,
    // which only ever fell out of step with the claim and invited code to read
    // the wrong value.
    //
    // Clients may write only the name fields, so nothing can be added here
    // that something might later mistake for authorization. The Admin SDK
    // (portal's /api/signup, admin's signup action) bypasses these rules.
    //
    // create stays open because admin's userService uses setDoc(merge) to let
    // accounts predating the users collection rename themselves; delete stays
    // open only for portal's rollbackNewUser (signup rollback, before a
    // session exists) - both sites' own account deletion now goes through
    // their /api/account route, using the Admin SDK, which bypasses these
    // rules entirely.
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if (isUser(userId) || isAdmin())
                    && request.resource.data.keys().hasOnly(['firstName', 'lastName']);
      allow update: if (isUser(userId) || isAdmin())
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['firstName', 'lastName']);
      allow delete: if isUser(userId) || isAdmin();
    }

    // The Firestore "Trigger Email" extension's queue. Nothing in the admin or
    // portal codebases reads or writes this collection - all mail goes through
    // SendGrid in $lib/server/email.ts - so an open create was a way for any
    // signed-in account to send mail from a gbSTEM address to any recipient.
    // The Admin SDK bypasses rules, so a server-side sender would still work
    // if one is ever added.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    //
    // ACCOUNT CREATION TOKENS
    //
    match /tokens/{token} {
      allow read, write: if isAdmin();
    }

    //
    // SEMESTER-SCOPED COLLECTIONS
    //
    // semesters/{semesterId}/applications/{userId}, .../registrations/{userId}, etc.
    //
    match /semesters/{semesterId} {
      allow read: if isSignedIn(); // parent docs, if we ever materialize them

      // Applicants create, save and submit their applications through
      // portal's /apply form actions, which validate and write with the Admin
      // SDK (bypassing these rules), so no applicant write is allowed here.
      // The edit dialog saves through admin's /applications?/saveApplication
      // action, also with the Admin SDK. Admins and reviewers still write
      // through the client SDK for decisions (meta.decided), notes and
      // meta.interview. TODO(server-side-forms): move those to the server
      // too, then drop the create/update rules below.
      match /applications/{userId} {
        allow read: if isInstructorUser(userId) || isAdminOrReviewer();
        allow create: if isAdminOrReviewer();
        allow update: if isAdminOrReviewer();
        // No delete rule: an instructor's own application is removed as part
        // of account deletion (portal's /api/account), with the Admin SDK.
      }

      // Parents create, save and submit registrations through portal's /apply
      // form actions and enroll through /api/enroll, all with the Admin SDK
      // (bypassing these rules), so no parent write is allowed here - which
      // also keeps `classes`/`enrolled` in step with each class's `students`.
      // The edit dialog saves through admin's /registrations?/saveRegistration
      // action, also with the Admin SDK. Admins still write through the
      // client SDK for studentService enrollment and the bypassAgeLimits
      // toggle. TODO(server-side-forms): move those to the server too, then
      // drop the create/update rules below.
      //
      // A registration is a minor's date of birth, race, phone number, school
      // and family income indicator (FRLP). Instructors never read this collection
      // directly through the client SDK; all instructor access is brokered by
      // server-side API routes (/api/classRoster, /api/remindStudents) that strictly
      // enforce class ownership and return only the minimal necessary fields.
      match /registrations/{userId} {
        allow read: if isStudentUserOrTheirChild(userId) || isAdminOrReviewer();
        allow create: if isAdmin();
        allow update: if isAdmin();
        // No delete rule: a parent's own registrations are removed as part
        // of account deletion (portal's /api/account), with the Admin SDK.
      }

      match /decisions/{userId} {
        allow read: if isInstructorUser(userId);
        allow read, write: if isAdminOrReviewer();
      }

      // Instructors write classes only through portal API routes, which check
      // the caller with the Admin SDK and write with it, bypassing these rules:
      // /api/classDetails (creation, details, co-instructors and ownership),
      // /api/classSchedule (rescheduling and holding a session),
      // /api/instructorFeedback (marking a session's feedback filed), and
      // /api/substituteSession and /api/substituteFeedback for a substitute,
      // who is never on a class's uid lists. Each route computes the derived
      // session state (classStatuses, feedbackCompleted) itself rather than
      // taking it from the client.
      match /classes/{classId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();
        allow update, delete: if isAdminOrReviewer();
      }

      // Admins and reviewers manage interview slots. Applicants see the open
      // ones and book one through portal's /api/interview, which books in a
      // transaction with the Admin SDK, so no applicant reads another's
      // booking or writes over it.
      match /instructorInterviewTimes/{interviewId} {
        allow read, write: if isAdminOrReviewer();
      }

      // Feedback is written only by the Admin SDK. Holding a role doesn't
      // authorize writing about a particular class or student, and a rule
      // can't check either, so filing goes through portal routes that do:
      // /api/studentFeedback (the caller's own student, on the class's
      // roster), /api/instructorFeedback (an accepted instructor of the
      // class) and /api/substituteFeedback (the session's substitute). They
      // also set every identifying field themselves.
      match /classFeedback/{feedbackId} {
        allow read: if isAdmin();
      }

      match /instructorFeedback/{feedbackId} {
        allow read: if isAdmin();
      }
    }

    //
    // INSTRUCTOR TO CLASS MAPPING
    //
    // Keyed by instructor uid: each document is `{ classIds: [...] }`, the
    // classes shared with that instructor. Server-only: portal's
    // /api/classDetails reads it and keeps it in step with each class's
    // otherInstructorUids through the Admin SDK, which bypasses these rules.
    match /instructorClasses/{userId} {
      allow read, write: if false;
    }

    //
    // INTERVIEW TIME REQUESTS
    //
    // Keyed `${uid}-${requestedDate}`. Applicants file a request through
    // portal's /api/slotRequest, which writes it with the Admin SDK and
    // notifies admins; listing and managing them is admin/reviewer work
    // (admin's interviewService.fetchSlotRequests).
    match /interviewTimeRequests/{requestId} {
      allow read, write: if isAdminOrReviewer();
    }

    //
    // SUBSTITUTE INSTRUCTORS REQUESTS
    //
    // Keyed `${classId}---${classNumber}`. The people a request belongs to
    // read it directly: whoever filed it, the class's instructor of record,
    // and the substitute covering it. Every instructor write goes through a
    // portal API route using the Admin SDK: filing, editing and cancelling
    // one through /api/subRequest, which takes the class's instructors from
    // the class document rather than from the caller; finding and claiming
    // open requests through /api/substitute; holding the session and filing
    // its feedback through /api/substituteSession and /api/substituteFeedback.
    match /subRequests/{subRequestId} {
      allow read: if isAdminOrReviewer() || isSubRequestParty(resource.data);
      allow write: if isAdmin();
    }

    //
    // PARENT / GUARDIAN CONFIRMATIONS
    //
    // The retreat-attendance form that wrote these (portal's
    // ConfirmationForm.svelte) was removed in 2025; nothing client-side
    // writes or reads this collection any more. Client access is closed -
    // only the Admin SDK, or a future feature explicitly reopening it,
    // reaches these documents now.
    match /confirmations/{userId} {
      allow read: if isAdminOrReviewer();
      allow write: if isAdmin();
    }

    //
    // REAL-TIME PROGRAM CHECK-INS AND MEAL CHECKOUTS
    //
    // Staff check students in and record meals from admin's StudentDetails
    // (studentService). Portal never reads or writes this collection - the
    // parent-facing check-in it once had is long gone - so parents have no
    // access, not even to their own children's records.
    match /checkIns/{userId} {
      allow read, write: if isAdminOrReviewer();
    }

    //
    // HELPER FUNCTIONS
    //
    // Roles come from the Auth custom claim, never from a document.
    //
    // There used to be a second helper, hasRole(), that read
    // users/$(uid).data.role - and isInstructor() used it. Since a user could
    // write their own users document, anyone signed in could grant themselves
    // the instructor role and everything it opened. Claims are set only by the
    // Admin SDK and arrive inside the verified ID token, so they cannot be
    // written by a client at all; they also cost no document read here, where
    // hasRole() cost an exists() plus a get() on every evaluation.
    //
    // Do not reintroduce a document-reading role helper. If a rule needs to
    // know something about a user beyond their role - whether an instructor
    // was accepted, say - check it in a server route with the Admin SDK
    // (portal's instructorDirectory.ts), as every instructor write now does.
    // If a rule ever must, read the document that actually records it, and
    // make sure that document is not client-writable.
    //
    // The one propagation caveat: a claim reaches request.auth.token only when
    // the ID token refreshes (within the hour). Code that changes a role should
    // force a refresh - see portal's SignUpForm - or revoke refresh tokens.
    function hasRRole(role) {
      return 'role' in request.auth.token && request.auth.token.role == role;
    }
    // The role means "has registered", not "is enrolled in a class" - it is
    // held from registration onward, long before any class placement.
    function isStudent() {
      return isSignedIn() && hasRRole('student');
    }
    // The role means "has applied to teach", not "teaches" - it is held from
    // signup onward, long before any interview.
    function isInstructor() {
      return isSignedIn() && hasRRole('instructor');
    }
    function hasUserId(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && hasRRole('admin');
    }
    function isAdminOrReviewer() {
      return isSignedIn() && (hasRRole('admin') || hasRRole('reviewer'));
    }
    function isSignedIn() {
      return request.auth != null;
    }
    // Filed the sub request, or is the instructor of record on its class.
    function isSubRequestOwner(data) {
      return isSignedIn()
        && (data.get('requestedByUid', '') == request.auth.uid
            || data.get('originalInstructorUid', '') == request.auth.uid);
    }
    // An owner (above), or the substitute covering the session.
    function isSubRequestParty(data) {
      return isSubRequestOwner(data)
        || (isSignedIn() && data.get('subInstructorId', '') == request.auth.uid);
    }
    // In gbSTEM, children do not have separate Auth accounts. A parent's
    // child registrations (and admin's check-ins) are keyed as `${parentUid}` (primary)
    // or `${parentUid}-1`, `${parentUid}-2`, ... up to maxChildrenPerAccount (5).
    // Matching exact UID or `${uid}-\d+` allows access to those child
    // documents while preventing arbitrary prefix collisions.
    function isUser(userId) {
      return isSignedIn() && hasUserId(userId);
    }
    function isInstructorUser(userId) {
      return isUser(userId) && isInstructor();
    }
    function isStudentUserOrTheirChild(userId) {
      return isStudent() && (userId == request.auth.uid || userId.matches(request.auth.uid + '-[0-9]+'));
    }
  }
}
